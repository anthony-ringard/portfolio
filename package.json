    "@types/node": "^20",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  }
